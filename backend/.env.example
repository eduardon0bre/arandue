# Porta de execução da API (O Railway injeta a variável PORT automaticamente)
PORT=3000
HOST=0.0.0.0

# Conexão MySQL no Railway:
# Ao adicionar o plugin "MySQL" no seu projeto do Railway,
# a variável MYSQL_URL é gerada automaticamente. O backend já suporta MYSQL_URL diretamente!
# Exemplo gerado pelo Railway: mysql://root:senha@roundhouse.proxy.rlwy.net:12345/railway
MYSQL_URL=

# Alternativa: Configuração com variáveis individuais (caso não use MYSQL_URL)
DB_HOST=127.0.0.1
DB_PORT=3308
DB_USER=bicos_user
DB_PASS=bicos_password
DB_NAME=quadro_bicos_db

# Ative caso o provedor de banco em nuvem exija conexão SSL (ex: Aiven / PlanetScale)
DB_SSL=false

# Segredo para assinatura de tokens JWT
JWT_SECRET=arandue-super-secret-jwt-key-2026

# ID do Cliente Google OAuth (mesmo valor utilizado no frontend)
GOOGLE_CLIENT_ID=

# -------------------------------------------------------------
# Sistema de Notificações Multi-Canal (WhatsApp, E-mail, Push)
# -------------------------------------------------------------

# Provedor de E-mail (Nodemailer): 'gmail' | 'ethereal' | 'resend' | 'sendgrid' | 'mock'
EMAIL_PROVIDER=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=tramontina9299@gmail.com
# Senha de App de 16 dígitos gerada na conta Google de tramontina9299@gmail.com:
# https://myaccount.google.com/apppasswords
SMTP_PASS=
EMAIL_FROM="Aranduê <tramontina9299@gmail.com>"
EMAIL_DEFAULT_TO=tramontina4040@gmail.com
EMAIL_FORCE_DEFAULT_TO=true
RESEND_API_KEY=
SENDGRID_API_KEY=

# Provedor de WhatsApp: 'twilio' | 'meta' | 'mock'
WHATSAPP_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+14155238886
WHATSAPP_META_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Provedor de Push Notifications: 'expo' | 'mock' (padrão: expo)
PUSH_PROVIDER=expo
